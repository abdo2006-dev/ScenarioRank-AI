# ── Backend: OpenAI provider configuration ──────────────────────────────────
# Loaded with this precedence (highest wins): real process environment >
# .env.local (git-ignored, developer-local) > .env (this template's shape).
# See server/config/env.js and docs/decisions/ADR-0003-runtime-provider-configuration.md.
#
# There is exactly one supported provider — OpenAI — see
# docs/decisions/ADR-0004-single-openai-provider.md for why Groq/Gemini
# were removed rather than kept as dormant alternatives.
#
# Backend-only: these keys are read via process.env in server.mjs / server/,
# never via import.meta.env, and must never be prefixed with VITE_ (any
# VITE_-prefixed variable is bundled into client-side JS and shipped to the
# browser — see the frontend section below).

# Required. Never expose this to the frontend or log it.
OPENAI_API_KEY=

# gpt-5-mini was verified at implementation time (2026-07-26) to be
# available to this project's account, to support Structured Outputs via
# the Responses API, and to accept the SDK's Zod helper correctly — see
# ADR-0004 for the exact real-account probe that confirmed this. Configure
# a different model here if your account's access changes.
OPENAI_MODEL=gpt-5-mini

# Optional. Constrains reasoning effort for structured-extraction stages —
# lower effort means faster, cheaper responses for tasks that don't need
# deep reasoning. Valid values (confirmed against the installed OpenAI
# SDK's own type definitions): none, minimal, low, medium, high, xhigh, max.
# Not every model supports every value (verified: gpt-5.4-mini rejects
# "minimal" with a 400 listing its own supported subset) — an unsupported
# combination surfaces as a clear API error, never a silent fallback.
# Leave unset to use the model's own default reasoning behavior.
OPENAI_REASONING_EFFORT=minimal

# Most candidates a single evaluation run may batch-score in one provider
# request. Must be an integer from 2 to 10; an invalid value falls back to
# the default (5) with a startup warning rather than failing the server.
# Requests above this limit are rejected before calling the model — see
# docs/PROJECT_STATUS.md for how 5 was chosen (schema size, output budget,
# cost, and current UI expectations).
AI_MAX_CANDIDATES=5

# There is no configurable "max provider requests per run" setting. This
# pipeline has a fixed maximum of 4 logical model-backed stages (combined
# context analysis, batch candidate scoring, batch pairing, decision
# explanation) — an architectural fact enforced internally
# (server/pipeline/runPipeline.js), not an environment-tunable knob. A
# logical stage's real OpenAI attempt count (retries, batch-integrity
# corrective calls) is reported separately in run_metadata.providerAttemptCount
# and is not bounded by this constant — see
# docs/decisions/ADR-0004-single-openai-provider.md.

# Optional. Defaults to 3001.
PORT=3001

# development | production. In production, invalid/missing OPENAI_API_KEY
# configuration fails startup immediately instead of starting half-broken.
NODE_ENV=development

# ── Frontend: build-time configuration ───────────────────────────────────────
# Read by src/pages/Index.tsx via import.meta.env — anything here IS bundled
# into client-side JS. Never place a provider API key under a VITE_ prefix.
VITE_BACKEND_URL=http://localhost:3001
