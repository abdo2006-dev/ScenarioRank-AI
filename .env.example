# ── Active pipeline (Phase 1A: still in use) ────────────────────────────────
# The live pipeline in server.mjs calls Anthropic directly through Phase 1A.
# This key is temporary and scheduled for removal once Phase 1B migrates the
# real pipeline stages onto the provider abstraction in server/ai/.
ANTHROPIC_API_KEY=

# Optional. Defaults to 3001.
PORT=3001

# ── Provider abstraction (Phase 1A: built, not yet wired into the pipeline) ─
# Everything below configures server/ai/providerFactory.js, which Phase 1A
# adds but does not call from the running server. It becomes load-bearing in
# Phase 1B, when Groq becomes the default runtime provider. Only ONE
# provider is used for a given evaluation run — never both.
#
# Backend-only: these keys are read via process.env in server.mjs / server/,
# never via import.meta.env, and must never be prefixed with VITE_ (any
# VITE_-prefixed variable is bundled into client-side JS and shipped to the
# browser).
#
# See docs/decisions/ADR-0002-provider-abstraction.md for the full
# reasoning behind these choices, including current source citations for
# the model names below (re-verify before relying on them — provider model
# lineups change).

AI_PROVIDER=groq

# Groq — the intended Phase 1B default. See ADR-0002 for why
# openai/gpt-oss-120b was chosen (a current production model, one of only
# two on the platform with strict-mode JSON Schema structured output).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini — optional alternative provider, for controlled comparison and
# experimentation only. GEMINI_MODEL has no built-in default (see
# server/ai/providers/geminiProvider.js) because Gemini model identifiers
# change over time; the value below was the current stable/GA Flash model
# at the time this file was written — see ADR-0002 for the source and
# re-verify before relying on it.
#
# DATA-USE WARNING (see ADR-0002 for the full statement): do not send real
# CVs, candidate records, interview notes, or other personal/confidential
# information through an unpaid Gemini API key. Use synthetic or
# explicitly non-sensitive examples only. Real candidate data and any
# production/public use requires a separate privacy, terms-of-service,
# consent, and paid-service review first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
