# ── Backend: AI provider configuration ──────────────────────────────────────
# Loaded with this precedence (highest wins): real process environment >
# .env.local (git-ignored, developer-local) > .env (this template's shape).
# See server/config/env.js and docs/decisions/ADR-0003-runtime-provider-configuration.md.
#
# Only ONE provider is used for a given evaluation run — never both, and
# never switched mid-run or per-candidate.
#
# Backend-only: these keys are read via process.env in server.mjs / server/,
# never via import.meta.env, and must never be prefixed with VITE_ (any
# VITE_-prefixed variable is bundled into client-side JS and shipped to the
# browser — see the frontend section below).

AI_PROVIDER=groq

# Groq — the default runtime provider. See ADR-0002 for why
# openai/gpt-oss-120b was chosen (a current production model, one of only
# two on the platform with strict-mode JSON Schema structured output).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini — optional alternative provider, for controlled comparison and
# experimentation only. GEMINI_MODEL has no built-in default (see
# server/ai/providers/geminiProvider.js) because Gemini model identifiers
# change over time; the value below was the current stable/GA Flash model
# at the time this file was written — see ADR-0002 for the source and
# re-verify before relying on it.
#
# DATA-USE WARNING (see ADR-0002 for the full statement): do not send real
# CVs, candidate records, interview notes, or other personal/confidential
# information through an unpaid Gemini API key. Use synthetic or
# explicitly non-sensitive examples only. Real candidate data and any
# production/public use requires a separate privacy, terms-of-service,
# consent, and paid-service review first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# How many candidate-scoring requests run concurrently. Must be an integer
# from 1 to 4; an invalid value falls back to the default (1) with a
# startup warning rather than failing the server. Defaults to 1 because a
# real Groq smoke test showed the default account tier returning HTTP 429
# the moment two candidate-scoring requests ran at once — see
# docs/PROJECT_STATUS.md and docs/decisions/ADR-0003-runtime-provider-configuration.md.
# If your provider account has a higher quota, you may deliberately raise
# this (2-4) to score candidates faster.
AI_CANDIDATE_CONCURRENCY=1

# Optional. Defaults to 3001.
PORT=3001

# development | production. In production, invalid/missing AI_PROVIDER
# configuration fails startup immediately instead of starting half-broken.
NODE_ENV=development

# ── Frontend: build-time configuration ───────────────────────────────────────
# Read by src/pages/Index.tsx via import.meta.env — anything here IS bundled
# into client-side JS. Never place a provider API key under a VITE_ prefix.
VITE_BACKEND_URL=http://localhost:3001
